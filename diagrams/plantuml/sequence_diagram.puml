@startuml
!theme plain
title Sequence Diagram - Class-Level Upload and Separation Flow

skinparam shadowing false

actor "Student / Researcher\nUser" as User
participant "UserInterface" as UI
participant "ModelsRouter" as ModelsRouter
participant "UploadRouter" as UploadRouter
participant "SeparationRouter" as SeparationRouter
participant "ResultsRouter" as ResultsRouter
participant "AudioValidator" as AudioValidator
participant "StorageService" as StorageService
participant "ModelService" as ModelService
participant "SeparationService" as SeparationService
participant "SeparationAlgorithmFactory" as Factory
participant "SeparationEngine" as Engine
participant "SeparationAlgorithm" as Algorithm
participant "ResultService" as ResultService

User -> UI : openPrototype()
UI -> ModelsRouter : available_models()
ModelsRouter -> ModelService : list_models()
ModelService --> ModelsRouter : models
ModelsRouter --> UI : modelList

User -> UI : selectWavAndModel()
UI -> UploadRouter : upload_audio(file)
UploadRouter -> AudioValidator : validate(upload_file)
AudioValidator --> UploadRouter : validationOk
UploadRouter -> StorageService : save_uploaded_wav(file)
StorageService --> UploadRouter : storedAudio
UploadRouter --> UI : audioId

UI -> SeparationRouter : separate_audio(audioId, modelId)
SeparationRouter -> SeparationService : separate_uploaded_audio(audioId, modelId)
SeparationService -> ModelService : get_model_for_separation(modelId)
ModelService --> SeparationService : selectedModel
SeparationService -> Factory : create_algorithm(selectedModel)
Factory --> SeparationService : algorithm
SeparationService -> Engine : SeparationEngine(algorithm)
SeparationService -> StorageService : build_separation_output_paths(jobId)
StorageService --> SeparationService : outputPaths
SeparationService -> Engine : separate(inputWav, modelPath, configPath)
Engine -> Algorithm : separate(inputWav, modelPath, configPath)
Algorithm --> Engine : heartAndLungOutputs
Engine --> SeparationService : outputMetadata
SeparationService -> ResultService : create_separation_result(jobId, outputMetadata)
ResultService --> SeparationService : result
SeparationService --> SeparationRouter : jobStatus
SeparationRouter --> UI : jobIdAndStatus

UI -> ResultsRouter : result_details(jobId)
ResultsRouter -> ResultService : get_result_details(jobId)
ResultService --> ResultsRouter : resultSummary
ResultsRouter --> UI : resultSummary
UI --> User : previewOrDownloadOutputs()

@enduml
