@startuml
title Sequence Diagram - Upload and Separation Workflow

actor "Student / Researcher User" as User
participant "User Interface" as UI
participant "Audio Validator" as Validator
participant "Preprocessing Service" as Preprocess
participant "Separation Model Service" as Model
participant "Result Manager" as Result
database "Storage" as Storage

User -> UI : Select and upload audio file
UI -> Validator : Validate file
Validator --> UI : Validation result

alt valid file
  UI -> Storage : Save uploaded file
  UI -> Preprocess : Prepare audio
  Preprocess --> UI : Prepared audio reference
  UI -> Model : Run separation
  Model --> UI : Heart and lung outputs
  UI -> Result : Register processing result
  Result -> Storage : Save output files
  Storage --> Result : Output file paths
  Result --> UI : Result summary
  UI --> User : Show result and download links
else invalid file
  UI --> User : Show validation error
end

@enduml
