@startuml
!theme plain
left to right direction
title Cardiopulmonary Sound Separation System - Use Case Diagram

actor "User / Student /\nResearcher" as User
actor "System Administrator" as Admin

rectangle "Cardiopulmonary Sound Separation System" {
  usecase "Upload cardiopulmonary\naudio" as UC1
  usecase "Validate audio file" as UC2
  usecase "Preprocess audio" as UC3
  usecase "Run sound separation" as UC4
  usecase "Generate heart\nsound output" as UC5
  usecase "Generate lung\nsound output" as UC6
  usecase "View result" as UC7
  usecase "Download separated\noutputs" as UC8
  usecase "View processing\nhistory" as UC9
  usecase "Manage dataset and\nsystem settings" as UC10
}

User --> UC1
User --> UC7
User --> UC8
User --> UC9
Admin --> UC10

UC1 --> UC2 : <<include>>
UC2 --> UC3 : <<include>>
UC3 --> UC4 : <<include>>
UC4 --> UC5 : <<include>>
UC4 --> UC6 : <<include>>
UC5 --> UC7 : <<include>>
UC6 --> UC7 : <<include>>

@enduml
