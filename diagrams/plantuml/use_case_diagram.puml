@startuml
!theme plain
title Use Case Diagram - Cardiopulmonary Sound Separation Prototype

left to right direction
skinparam shadowing false

actor "Student / Researcher\nUser" as User

rectangle "Cardiopulmonary Sound Separation Prototype" {
  usecase "Upload mixed\ncardiopulmonary audio" as UCUpload
  usecase "Select separation\nmodel" as UCSelectModel
  usecase "Run sound\nseparation" as UCRun
  usecase "View processing\nstatus" as UCStatus
  usecase "View separated\nresult" as UCView
  usecase "Preview heart and\nlung audio" as UCPreview
  usecase "Download separated\noutputs" as UCDownload
  usecase "View processing\nhistory" as UCHistory
  usecase "View evaluation\nmetrics" as UCMetrics
}

User -- UCUpload
User -- UCSelectModel
User -- UCRun
User -- UCStatus
User -- UCView
User -- UCPreview
User -- UCDownload
User -- UCHistory
User -- UCMetrics

@enduml
