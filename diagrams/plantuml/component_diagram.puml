@startuml
!theme plain
title Component Diagram - Cardiopulmonary Sound Separation Prototype

left to right direction
skinparam shadowing false

actor "Student / Researcher\nUser" as User

rectangle "Prototype Application" {
  component "Browser Interface" as Web
  component "Backend API\nRoutes" as API
  component "Service Layer" as Services
  component "Model Registry\nand Selection" as Registry
  component "Audio Preprocessing\nModule" as Preprocess
  component "Separation Strategy\nInterface" as Strategy
  component "Evaluation Module" as Eval
  component "Result and History\nModule" as Result
  database "SQLite Metadata\nDatabase" as DB
  folder "Filesystem Storage\nUploads / Outputs / Models" as FS
}

component "Fixed Filter\nBaseline" as Filter
component "NMF\nStrategy" as NMF
component "VMD\nStrategy" as VMD
component "NeoSSNet Deep\nStrategy" as Neo

User --> Web : upload, select model,\npreview, download
Web --> API : HTTP requests
API --> Services : route calls
Services --> Registry : list or load model
Services --> Preprocess : prepare waveform
Services --> Strategy : run selected strategy
Strategy --> Filter
Strategy --> NMF
Strategy --> VMD
Strategy --> Neo
Services --> Result : save and read results
Services --> DB : metadata, jobs,\nmetrics, logs
Services --> FS : WAV and model files
Result --> DB
Result --> FS
Eval --> DB : planned metrics
Web <-- API : status, outputs,\nhistory, metrics

@enduml
