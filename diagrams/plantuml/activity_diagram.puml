@startuml
!theme plain
title Activity Diagram - Model-Selectable Sound Separation Workflow

skinparam shadowing false

start
:Open prototype interface;
:Load available model list;
:Select mixed cardiopulmonary WAV file;

if (Model selected?) then (yes)
  :Use selected model record;
else (no)
  :Use active default model;
endif

:Upload audio file;

if (File valid?) then (yes)
  :Store upload metadata;
  :Preprocess audio;
  if (Preprocessing successful?) then (yes)
    :Create separation job;
    :Resolve algorithm strategy\nfrom selected model;
    if (Model configuration valid?) then (yes)
      :Run selected separation strategy;
      if (Heart and lung outputs generated?) then (yes)
        :Save output metadata;
        :Display processing result;
        :Preview or download outputs;
      else (no)
        :Mark job failed;
        :Show separation failure message;
      endif
    else (no)
      :Mark job failed;
      :Show model configuration error;
    endif
  else (no)
    :Show preprocessing failure message;
  endif
else (no)
  :Show validation error message;
endif

stop
@enduml
